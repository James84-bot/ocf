# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# --- Core ---
PORT=3000
NODE_ENV=development

# Long, random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Where the SQLite database file lives. The default is fine for most
# deployments — just make sure this path is on persistent storage (some
# hosts wipe the filesystem on every deploy, which would lose your data).
DATABASE_PATH=./data/unity_shelf.db

# Comma-separated list of origins allowed to call this API. Add your
# deployed front-end's URL here in production (e.g. your GitHub Pages /
# Netlify / Vercel domain) — the frontend will get CORS errors without it.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# --- Email (staff OTP + reservation-ready notices) ---
# Leave blank to run without real email — verification codes and
# reservation-ready notices just get printed to this server's terminal
# instead, which is fine for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Knowledge Hub <no-reply@unityhomes.co.ke>"

# --- SMS (resident OTP + reservation-ready notices, via Africa's Talking) ---
# Leave blank to run without real SMS — same console-fallback behavior.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# =====================================================================
# Your organisation. Change these to run Unity Shelf as your own library.
# Every value is optional: the defaults are the original Unity Homes setup.
# =====================================================================
ORG_NAME=Unity Homes
LIBRARY_NAME=Knowledge Hub
# LIBRARY_TAGLINE=A shared shelf for every Unity Homes estate.
# LIBRARY_INTRO=Borrow a book, pass it on, and meet your neighbours in between.
# LOGO_URL=logo-mark.png            # path or URL to a square logo; 'none' for no logo
# ACCENT_COLOR=#FC4F5A              # buttons and highlights, hex

# Where books live and members belong, comma-separated.
BRANCHES=Unity One,Unity West,Unity East,Unity Gardens,Silver Hill,Unity Parkside
BRANCH_LABEL=Estate                 # e.g. Campus, Office, Branch
MEMBER_LABEL=Resident               # e.g. Student, Employee, Member
UNIT_LABEL=Unit Number              # e.g. Admission Number, Staff ID

# Domain required for Staff/Library Assistant work-email registration.
STAFF_EMAIL_DOMAIN=unityhomes.co.ke

# Lending rules. The server enforces these.
LOAN_DAYS=21
FINE_PER_DAY=50
CURRENCY=KSH
SUSPEND_AFTER_DAYS=14
HOLD_HOURS=48

# Serve the website from this server too (one URL for everything).
# Set to false if the frontend is hosted separately, e.g. on GitHub Pages.
SERVE_FRONTEND=true
