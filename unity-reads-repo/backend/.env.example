# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# --- Core ---
PORT=3000
NODE_ENV=development

# Long, random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Where the SQLite database file lives. The default is fine for most
# deployments — just make sure this path is on persistent storage (some
# hosts wipe the filesystem on every deploy, which would lose your data).
DATABASE_PATH=./data/unity_shelf.db

# Comma-separated list of origins allowed to call this API. Add your
# deployed front-end's URL here in production (e.g. your GitHub Pages /
# Netlify / Vercel domain) — the frontend will get CORS errors without it.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# --- Email (staff OTP + reservation-ready notices) ---
# Leave blank to run without real email — verification codes and
# reservation-ready notices just get printed to this server's terminal
# instead, which is fine for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Unity Reads <no-reply@unityhomes.co.ke>"

# --- SMS (resident OTP + reservation-ready notices, via Africa's Talking) ---
# Leave blank to run without real SMS — same console-fallback behavior.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Domain required for Staff/Library Assistant work-email registration.
STAFF_EMAIL_DOMAIN=unityhomes.co.ke
