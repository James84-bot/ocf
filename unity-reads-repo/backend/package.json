{
  "name": "unity-shelf-backend",
  "version": "3.0.0",
  "description": "Unity Shelf library backend \u2014 Express + SQLite, self-contained, no external DB service required. Serves the same /webhook/* endpoints the front end already calls.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "demo-catalogue": "node scripts/build-demo-catalogue.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "express-rate-limit": "^7.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "axios": "^1.7.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
